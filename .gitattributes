# Shell scripts run inside Linux containers: they must keep LF line endings even when the
# repository is checked out on Windows, otherwise bash fails with "$'\r': command not found".
*.sh   text eol=lf
*.sql  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.png  binary
